# Dokploy → Application → Environment sekmesine yapıştırılacak değişkenler.
# Gizli olmayan değerler doldurulmuştur; <...> ile işaretli üç alanı kendiniz girin.

# Dokploy'da oluşturduğunuz PostgreSQL servisinin "Internal Connection URL" değeri
DATABASE_URL=<postgres-internal-connection-url>

# Canonical alan adı (www'siz, sonda / yok). Geçici adreste denerken de bunu değiştirmeyin.
SITE_URL=https://oceaninsaat.com.tr

# En az 32 karakter rastgele değer. Sunucuda üretin: openssl rand -hex 32
APP_SECRET=<openssl-rand-hex-32-ciktisi>

# Yüklenen dosyalar; Dokploy'da /data/storage yoluna kalıcı birim (volume) bağlayın
STORAGE_DIR=/data/storage
PORT=3000

# Yeni talep bildirimlerinin gideceği adresler
LEAD_NOTIFY_EMAIL=destek@oceaninsaat.com.tr,info@oceaninsaat.com.tr

# E-posta gönderimi (boş bırakılırsa talepler kaydedilir, yalnızca bildirim e-postası gitmez)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=destek@oceaninsaat.com.tr
SMTP_PASSWORD=<smtp-parolasi>
SMTP_FROM=Ocean İnşaat <destek@oceaninsaat.com.tr>
