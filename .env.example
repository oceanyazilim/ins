# --- Zorunlu ---
# PostgreSQL bağlantısı. Yerel geliştirmede `npm run db:start` 54329 portunda gömülü PostgreSQL başlatır.
DATABASE_URL=postgres://ocean:ocean@localhost:54329/ocean
# Canonical ana domain (sonunda / olmadan, www'siz)
SITE_URL=https://oceaninsaat.com.tr
# IP özetleme ve imzalama için en az 32 karakterlik rastgele değer: `openssl rand -hex 32`
APP_SECRET=

# --- İlk yönetici (yalnızca `npm run admin:create` tarafından okunur) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- E-posta bildirimi (boş bırakılırsa bildirimler yalnızca sunucu günlüğüne yazılır) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Ocean İnşaat <destek@oceaninsaat.com.tr>"
# Yeni teklif taleplerinin gönderileceği adres(ler), virgülle ayrılır
LEAD_NOTIFY_EMAIL=destek@oceaninsaat.com.tr,info@oceaninsaat.com.tr

# --- Dosya depolama ---
# Teklif fotoğrafları ve medya kütüphanesi için kalıcı dizin (web kökü dışında)
STORAGE_DIR=./storage
